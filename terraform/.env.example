# AWS Credentials (configure via AWS CLI profiles or IAM roles if running on EC2/ECS/Lambda)
# AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
# AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
# AWS_SESSION_TOKEN="YOUR_AWS_SESSION_TOKEN" # Optional, for temporary credentials

# AWS Region
TF_VAR_aws_region="us-east-1"

# Project Name (used for prefixing resources)
TF_VAR_project_name="siem_poc"

# OpenSearch Configuration
TF_VAR_opensearch_domain_name="siem-identity-logs"
# TF_VAR_opensearch_master_user_name="admin" # Optional: If not set, Terraform will not create one, relying on auto-created or manual.
# TF_VAR_opensearch_master_user_password="YourStrongPassword123!" # Optional: Highly sensitive. Ensure this file is in .gitignore.

# Kinesis, Lambda, Firehose, S3 - names will be prefixed by project_name
# TF_VAR_kinesis_stream_name_suffix="raw-logs"
# TF_VAR_lambda_function_name_suffix="transformer"
# TF_VAR_firehose_s3_bucket_name_suffix="firehose-backups"

# Optional: Specific IP for OpenSearch Dashboards access if not using VPC endpoint or other methods
# TF_VAR_dashboard_access_ip="0.0.0.0/0" # WARNING: This makes Dashboards publicly accessible. Secure with FGAC.
                                        # For production, use a specific IP or VPN.
                                        # If using VPC, this might not be needed or would be different.
```
