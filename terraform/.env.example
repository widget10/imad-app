# AWS Credentials (configure via AWS CLI profiles or IAM roles if running on EC2/ECS/Lambda)
# AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
# AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
# AWS_SESSION_TOKEN="YOUR_AWS_SESSION_TOKEN" # Optional, for temporary credentials

# AWS Region
TF_VAR_aws_region="us-east-1"

# Project Name (used for prefixing resources)
TF_VAR_project_name="siem_poc_msk" # Consider updating project name slightly for MSK version if deploying alongside old

# --- VPC Configuration ---
TF_VAR_vpc_cidr="10.0.0.0/16"
TF_VAR_public_subnet_cidrs='["10.0.1.0/24", "10.0.2.0/24"]' # Ensure these are valid JSON arrays if copy-pasting
TF_VAR_private_subnet_cidrs='["10.0.101.0/24", "10.0.102.0/24"]'

# --- OpenSearch Configuration ---
TF_VAR_opensearch_domain_name="siem-identity-msk-logs" # Example: slightly different name for MSK version
TF_VAR_opensearch_engine_version="OpenSearch_2.11"
TF_VAR_opensearch_instance_type="t3.small.search"
TF_VAR_opensearch_instance_count=2 # For VPC, 2 AZs often used with MSK, so 2 data nodes good for PoC
# TF_VAR_opensearch_master_user_name="admin"
# TF_VAR_opensearch_master_user_password="YourStrongPassword123!" # HIGHLY SENSITIVE
# TF_VAR_dashboard_access_ip_ranges='["YOUR_HOME_OR_VPN_IP/32"]' # Recommended to restrict access

# --- MSK (Managed Streaming for Kafka) Configuration ---
TF_VAR_msk_broker_instance_type="kafka.t3.small"
TF_VAR_msk_kafka_version="2.8.1" # Check AWS console for latest supported versions
TF_VAR_msk_number_of_broker_nodes=2 # Should match number of private subnets/AZs for PoC
TF_VAR_msk_broker_ebs_volume_size=20 # In GiB
TF_VAR_msk_topic_name="identity-logs"

# --- Lambda (MSK Consumer) Configuration ---
TF_VAR_lambda_runtime="python3.9"
# TF_VAR_lambda_handler_name="msk_consumer_lambda.lambda_handler" # Defined in main.tf, not usually needed here
TF_VAR_lambda_memory_size=512 # Might need more for Kafka clients and OpenSearch client
TF_VAR_lambda_timeout=300 # 5 minutes, adjust based on batch size and processing


# --- Commented out Kinesis/Firehose related variables (no longer used) ---
# # TF_VAR_kinesis_stream_name_suffix="raw-logs"
# # TF_VAR_lambda_function_name_suffix="transformer" # Old lambda name
# # TF_VAR_firehose_s3_bucket_name_suffix="firehose-backups"
```
